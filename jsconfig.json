{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "backend/node_modules",
    "frontend/node_modules",
    "dist",
    "frontend/dist"
  ]
}
